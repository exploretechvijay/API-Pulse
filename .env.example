# ---- required ----
# Encrypts secrets (tokens, passwords, webhook URLs) at rest. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: without it, stored secrets cannot be decrypted. If unset, a key file is
# generated in the data directory instead (back it up together with the database).
APP_SECRET=

# ---- first admin (optional; otherwise create it in the browser on first visit) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- networking ----
# Public URL, used for links in alert notifications
BASE_URL=http://localhost:8080
# Host port published by docker compose
PULSE_PORT=8080
# Set to true when running behind a reverse proxy (Caddy / nginx / Traefik)
TRUST_PROXY=false
# Mark the session cookie Secure (set true whenever users reach the UI over HTTPS)
SECURE_COOKIES=false
# Domain for the optional Caddy HTTPS profile
DOMAIN=pulse.example.com

# ---- built-in HTTPS (alternative to Caddy) ----
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem

# ---- other ----
# Apply a YAML/JSON config file (merge) on every start
# CONFIG_FILE=/config/api-pulse.yaml
# Session lifetime in hours
SESSION_TTL_HOURS=168
# CPU % above which load-test results are flagged as possibly limited by this machine
CPU_WARN_PERCENT=85
# Time zone for daily scheduled tests
TZ=UTC
